{
  "enabled": true,
  "name": "Notify Bridge Idle",
  "description": "When Kiro agent stops, notify the bridge service to set state to idle (stops ghost animation on MX Console LCD).",
  "version": "1",
  "when": {
    "type": "agentStop"
  },
  "then": {
    "type": "runCommand",
    "command": "curl -s http://localhost:9848/state/idle"
  }
}